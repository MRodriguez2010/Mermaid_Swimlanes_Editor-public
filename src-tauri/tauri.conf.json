{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mermaid Local",
  "version": "0.1.0",
  "identifier": "local.mermaid.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mermaid Local",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob; worker-src 'self' blob;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
